# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.
#
# Vars prefixed VITE_ are bundled into the frontend by Vite — only put
# values here that are safe to ship to the browser (protected by Supabase
# Row Level Security). Everything else is server-only: used by Netlify
# Functions and by the Vite dev-server proxy plugins (read via loadEnv,
# never exposed to the browser).

# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Same project URL, plus the service_role key (server-only — bypasses RLS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (test mode keys while developing) ────────────────────────────
STRIPE_SECRET_KEY=
# From `stripe listen` output, or the Stripe Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Price ID of the recurring subscription price (Product catalog → Price).
STRIPE_PRICE_ID=

# Base URL used to build Stripe Checkout/Portal success/cancel/return URLs.
# e.g. http://localhost:5173 in dev, https://yourapp.netlify.app in prod.
PUBLIC_SITE_URL=

# ── Existing (transcript fetching in production) ─────────────────────────
SUPADATA_API_KEY=

# ── Sentry (error monitoring) ────────────────────────────────────────────
# Project Settings → Client Keys (DSN) in Sentry.
# If unset, error tracking is disabled (safe for local dev/test).
VITE_SENTRY_DSN=
# Server-side DSN for Netlify Functions — can reuse the same DSN as above.
SENTRY_DSN=
